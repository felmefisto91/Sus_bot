# Use a dedicated Discord application/token for this standalone bot.
DISCORD_TOKEN=your_standalone_alliance_bot_token

# Google service account file and spreadsheet shared with the corporation bot.
GOOGLE_CREDS_FILE=credentials.json
SPREADSHEET_ID=your_google_spreadsheet_id

# Discord channel where /init_alliance_siege will publish the panel.
ALLIANCE_SIEGE_CHANNEL_ID=123456789012345678

# Comma-separated role IDs allowed to reset the current week.
OFFICER_ROLE_IDS=123456789012345678,234567890123456789

# Optional role pinged by the daily and weekly notices. Set 0 to disable it.
SIEGE_ROLE_ID=123456789012345678

# Worksheet names. Keep these values to reuse the existing data.
ALLIANCE_ROSTER_SHEET=AllianceRoster
ALLIANCE_SIEGE_SHEET=AllianceSiege